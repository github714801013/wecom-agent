{
  "llm": {
    "apiKey": "${LLM_API_KEY}",
    "baseUrl": "${LLM_BASE_URL}",
    "modelName": "MiniMax-M2.5",
    "recursionLimit": 25,
    "contextWindow": 0
  },
  "vision": {
    "enabled": true,
    "apiKey": "${LLM_API_KEY}",
    "baseUrl": "${LLM_BASE_URL}",
    "modelName": "gemini-3.1-pro-preview"
  },
  "mcpServers": [
    {
      "name": "gitnexus",
      "url": "http://127.0.0.1:1348/sse",
      "type": "sse",
      "headers": {
        "x-server": "gitnexus"
      },
      "headerProfiles": {
        "/oa": {
          "projects": "oa-stock,jiuji-m,9ji-admin,MyDjangoProject,jiuji-mp,yimagz_submit,oa-order,autoTransfer,oa-pc,oa-after,oa-finance,huishou,oanew,saasoanew,oa-api,nc-segments,logistics,orginfo,StateAllowanceDeclaration,web,oa-pay,iteng-sp"
        },
        "/neo": {
          "projects": "small-oa,jiuyun-oa,neo-oa,jiuyun-moa"
        }
      }
    },
    {
      "name": "db",
      "url": "http://127.0.0.1:1248/sse",
      "type": "sse",
      "headers": {}
    }
  ],
  "bots": [
    {
      "name": "robot-a",
      "botId": "${WECOM_ROBOT_A_BOT_ID}",
      "secret": "${WECOM_ROBOT_A_SECRET}",
      "wsUrl": "wss://openws.work.weixin.qq.com",
      "mcpHeaders": {
        "gitnexus": {
          "x-robot": "robot-a"
        }
      },
      "defaultMcpHeaderCommand": "/oa"
    },
    {
      "name": "robot-b",
      "botId": "${WECOM_ROBOT_B_BOT_ID}",
      "secret": "${WECOM_ROBOT_B_SECRET}",
      "wsUrl": "wss://openws.work.weixin.qq.com",
      "mcpHeaders": {
        "db": {
          "x-project": "project-b",
          "x-robot": "robot-b"
        },
        "gitnexus": {
          "x-robot": "robot-b"
        }
      },
      "defaultMcpHeaderCommand": "/neo"
    }
  ],
  "tools": {
    "allowed": [],
    "excluded": [],
    "cacheTtlMinutes": 30,
    "maxAgentToolResultsPerTurn": 64
  }
}
