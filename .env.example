# 可选：不设置时默认读取 config/wecom-agent.config.json
CONFIG_FILE=config/wecom-agent.config.json

# 大模型密钥信息，由 config/wecom-agent.config.json 中的 ${ENV_NAME} 引用
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://your_llm_api_base_url_here

# 企业微信机器人密钥信息，由 config/wecom-agent.config.json 中的 ${ENV_NAME} 引用
WECOM_ROBOT_A_BOT_ID=your_robot_a_bot_id_here
WECOM_ROBOT_A_SECRET=your_robot_a_secret_here
WECOM_ROBOT_B_BOT_ID=your_robot_b_bot_id_here
WECOM_ROBOT_B_SECRET=your_robot_b_secret_here
